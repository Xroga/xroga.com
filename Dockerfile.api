# Portable API image. Build context is the monorepo root.
# Supply the exact source commit through XROGA_RELEASE_SHA.

ARG NODE_VERSION=22.21.1
FROM node:${NODE_VERSION}-slim AS base

WORKDIR /app

ENV NODE_ENV="production"
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV npm_config_loglevel=warn

FROM base AS build

COPY backend/package.json backend/package-lock.json ./
COPY backend/scripts/cline-git-compat.mjs ./scripts/cline-git-compat.mjs
COPY backend/scripts/security-dependency-patches.mjs ./scripts/security-dependency-patches.mjs
COPY backend/vendor/cline ./vendor/cline

# package-lock.json must include every dependency in package.json (npm ci fails otherwise)
RUN npm ci --include=dev --ignore-scripts
RUN node scripts/cline-git-compat.mjs --apply
RUN node scripts/security-dependency-patches.mjs --apply

COPY backend/tsconfig.json tsconfig.json
COPY backend/src ./src

RUN npm run build && test -f dist/index.js

RUN npm prune --omit=dev

FROM base

ARG XROGA_RELEASE_SHA=unknown
RUN printf '%s' "$XROGA_RELEASE_SHA" | grep -Eq '^[a-f0-9]{40}$'
ENV XROGA_RELEASE_SHA=$XROGA_RELEASE_SHA
LABEL org.opencontainers.image.revision=$XROGA_RELEASE_SHA

# Legacy AI/video stack removed — no ffmpeg/playwright runtime deps needed.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /app /app

EXPOSE 8080

CMD [ "node", "dist/index.js" ]
