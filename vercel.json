{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend --workspaces=false",
  "buildCommand": "npm run build --prefix frontend --workspaces=false",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- frontend/ package.json package-lock.json vercel.json scripts/enforce-next-postcss.mjs",
  "redirects": [
    {
      "source": "/dashboard/upgrade",
      "destination": "/pricing",
      "permanent": false
    }
  ]
}
