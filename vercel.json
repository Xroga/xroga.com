{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend --workspaces=false",
  "buildCommand": "npm run build --prefix frontend --workspaces=false",
  "framework": "nextjs",
  "ignoreCommand": "node scripts/ci/ignore-vercel-build.mjs",
  "redirects": [
    {
      "source": "/dashboard/upgrade",
      "destination": "/pricing",
      "permanent": false
    }
  ]
}
