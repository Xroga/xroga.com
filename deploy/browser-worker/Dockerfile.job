# Build context: repository root, after compiling the exact backend source.
# Candidate only. No deployment until network, sandbox and private delivery gates pass.
FROM mcr.microsoft.com/playwright:v1.62.0-noble@sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07
ARG XROGA_RELEASE_SHA
RUN printf '%s' "$XROGA_RELEASE_SHA" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.source="https://github.com/Xroga/xroga.com" org.opencontainers.image.revision=$XROGA_RELEASE_SHA
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright XROGA_RUNTIME_ROLE=browser-job
RUN groupadd --gid 10001 browser && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin browser
WORKDIR /opt/xroga-browser-worker
COPY deploy/browser-worker/package.json deploy/browser-worker/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY deploy/browser-worker/runJob.mjs deploy/browser-worker/runCloudJob.mjs deploy/browser-worker/runCloudSandbox.mjs deploy/browser-worker/proxyChannel.mjs deploy/browser-worker/jobEnvelope.mjs ./
COPY deploy/browser-worker/probeCloudJob.mjs ./
COPY backend/dist/workers/browserJob.js backend/dist/workers/browserPlan.js backend/dist/workers/chromiumLaunch.js backend/dist/workers/egressProxy.js ./policy/workers/
COPY backend/dist/security/boundedPublicGet.js ./policy/security/
RUN mkdir -p /run/xroga-job /tmp/xroga-browser && chown -R 10001:10001 /run/xroga-job /tmp/xroga-browser
USER 10001:10001
ENTRYPOINT ["node","/opt/xroga-browser-worker/runCloudJob.mjs"]
