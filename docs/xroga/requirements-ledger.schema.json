{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "assessment": {
      "type": "string",
      "enum": [
        "AVAILABLE_SOURCE_RECONCILIATION",
        "FULL_HISTORICAL_COVERAGE"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "user_need": {
            "type": "string"
          },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "locator"
              ],
              "additionalProperties": false
            }
          },
          "feature_category": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "infrastructure",
              "security"
            ]
          },
          "current_state": {
            "type": "string",
            "enum": [
              "IMPLEMENTED_AND_REACHABLE",
              "IMPLEMENTED_BUT_UNVERIFIED",
              "PARTIAL",
              "PLACEHOLDER",
              "DEAD_OR_UNREACHABLE",
              "PROPOSED_ONLY",
              "UNKNOWN_BLOCKED"
            ]
          },
          "current_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_owner_command": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "security_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cost_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_method": {
            "type": "string"
          },
          "acceptance_criteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_repo_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "KEEP",
              "EXTEND",
              "REPLACE",
              "DEPRECATE",
              "NEW"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "unresolved_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_reported_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "requirement_id",
          "title",
          "description",
          "user_need",
          "source_refs",
          "feature_category",
          "classification",
          "current_state",
          "current_paths",
          "implementation_owner_command",
          "priority",
          "dependencies",
          "provider_dependencies",
          "security_implications",
          "data_implications",
          "authority_implications",
          "cost_implications",
          "verification_method",
          "acceptance_criteria",
          "external_repo_candidates",
          "disposition",
          "rationale",
          "confidence",
          "unresolved_questions",
          "source_reported_states"
        ],
        "additionalProperties": false
      }
    },
    "source_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_row_id": {
            "type": "string"
          },
          "requirement_id": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "source_row_id",
          "requirement_id"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "imported_available_rows": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mapped_available_rows": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "historical_feature_rows_expected": {
          "type": "number",
          "const": 119
        },
        "historical_feature_rows_supplied": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "historical_feature_rows_mapped": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "historical_missions_expected": {
          "type": "number",
          "const": 72
        },
        "historical_missions_supplied": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "historical_missions_mapped": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "historical_coverage_complete": {
          "type": "boolean"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "imported_available_rows",
        "mapped_available_rows",
        "historical_feature_rows_expected",
        "historical_feature_rows_supplied",
        "historical_feature_rows_mapped",
        "historical_missions_expected",
        "historical_missions_supplied",
        "historical_missions_mapped",
        "historical_coverage_complete",
        "deferred"
      ],
      "additionalProperties": false
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issue": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sources",
          "issue",
          "resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "source_sha",
    "assessment",
    "requirements",
    "source_mappings",
    "coverage",
    "contradictions"
  ],
  "additionalProperties": false
}
