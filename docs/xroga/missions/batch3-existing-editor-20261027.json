  "decisions": {
    "keep": [
      "Canonical scheduler, SoftwareAgent, repositoryTools session, patch workspace and GitHub persistence",
      "Codex Batch 1/1.5/2 activation work untouched",
      "Existing GitHub OAuth connection and its revocation semantics"
    ],
    "extend": [
      "Existing repositories are bound by GitHub immutable repository id, connected account and exact base commit",
      "Tree reads walk truncated trees directory by directory and report partial honestly",
      "Credential-bearing paths are listed but their content is never fetched"
    ],
    "replace": [],
    "deprecate": []
  },
  "schemaImpact": {
    "changed": true,
    "migrations": [
      "supabase/migrations/20261027000000_existing_source_projects.sql",
      "supabase/migrations/20261027010000_existing_source_indexes.sql",
      "supabase/migrations/20261027020000_existing_source_archives.sql",
      "supabase/migrations/20261027030000_existing_source_changes.sql"
    ],
    "rollout": "Additive service-role-only table with RLS and no public grants. Not applied by this change; apply through the verified migration workflow after authorisation.",
    "rollback": "DROP TABLE public.existing_source_changes; DROP TABLE public.existing_source_archives; DROP TABLE public.existing_source_indexes; DROP TABLE public.existing_source_projects; (the archive migration also relaxes the origin_kind check; nothing else references these tables)."
  },
  "securityImpact": {
    "auth": {
      "changed": true,
      "description": "New /api/existing-source routes require the issued tenant context and are off unless XROGA_EXISTING_SOURCE=1."
    },
    "tenant": {
      "changed": true,
      "description": "Every binding query carries the verified owner; another owner's binding id is indistinguishable from one that does not exist; the same repository linked by two owners stays two bindings. Code maps are stored per owner and binding, service-role only with RLS, cascade on unlink, purged on revocation, transfer, account change and removed connection; another owner's map is indistinguishable from a missing one."
    },
    "approval": {
      "changed": true,
      "description": "Delivery writes a NEW review branch and opens a draft PR only after the binding is re-verified at the provider, the account can push, the remote head is re-read, credentials and workflow paths are scanned out, and the change is verified (or explicitly confirmed unverified). It never writes the base or a protected branch and never force-pushes. An unverified change needs an explicit acknowledgement before a draft PR."
    },
    "credentials": {
      "changed": true,
      "description": "The connected account token is resolved server-side and never returned; .env, key and credential files are never fetched; secrets inside ordinary files are redacted by the existing tool session."
    },
    "egress": {
      "changed": false,
      "description": "Calls only api.github.com with the connected account's own token, addressed by repository id; blob fetches for the map skip sensitive, vendored, generated, binary and oversize files. No repository content reaches a model in these phases; the passport carries signatures and paths, not bodies. A ZIP import is read only from the owner's own upload; entries are validated (no traversal, symlink, encrypted, bomb), and credentials and binaries are never stored. Change execution and tests run only through the isolation runtime port (never on the API host); with no runtime the change ends unverified."
    },
    "cost": {
      "changed": false,
      "description": "Map builds are bounded (1500 blob fetches, 24 MB, one build at a time per owner, shared in-flight builds); persisted map capped at 8 MB. No model spend."
    },
    "billing": {
      "changed": false,
      "description": "None."
    }
  },
  "tests": [
    {
      "command": "node node_modules/tsx/dist/cli.mjs --test backend/src/existingSource/service.test.ts backend/src/existingSource/provider.test.ts backend/src/routes/existingSource.test.ts backend/src/routes/existingSourceIntelligence.test.ts",
      "scope": "Link, tenant isolation, revocation, exact-commit reads, and the code map routes over HTTP",
      "negative": true,
      "reference": "backend/src/routes/existingSourceIntelligence.test.ts"
