{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "assessment": {
      "type": "string",
      "const": "READ_ONLY_RUNTIME_AUDIT"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependency_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "provider": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "PRODUCTION",
              "PREVIEW",
              "LOCAL",
              "PROPOSED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CONFIGURED_BUT_UNVERIFIED",
              "LEGACY",
              "LOCAL_ONLY",
              "PROPOSED"
            ]
          },
          "runtime_owner": {
            "type": "string"
          },
          "config_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hostnames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": "string"
          },
          "auth_mechanism": {
            "type": "string"
          },
          "secret_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inbound_callers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outbound_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "health_readiness": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          },
          "retry_policy": {
            "type": "string"
          },
          "idempotency_expectation": {
            "type": "string"
          },
          "data_classification": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string"
          },
          "fallback_behaviour": {
            "type": "string"
          },
          "observability_source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "production_verification": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dependency_id",
          "provider",
          "purpose",
          "environment",
          "state",
          "runtime_owner",
          "config_sources",
          "hostnames",
          "resource_id",
          "region",
          "auth_mechanism",
          "secret_names",
          "inbound_callers",
          "outbound_dependencies",
          "health_readiness",
          "timeout",
          "retry_policy",
          "idempotency_expectation",
          "data_classification",
          "failure_mode",
          "fallback_behaviour",
          "observability_source",
          "production_verification",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "environment_names": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "consuming_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secret_class": {
            "type": "string",
            "enum": [
              "SERVER_CREDENTIAL",
              "PUBLIC_CREDENTIAL",
              "PUBLIC_IDENTIFIER",
              "RUNTIME_CONFIGURATION",
              "SYSTEM_CONFIGURATION"
            ]
          },
          "rotation_owner": {
            "type": "string"
          },
          "requiredness": {
            "type": "string",
            "enum": [
              "REQUIRED_FOR_CORE_AUTH",
              "CONDITIONAL_ON_CAPABILITY",
              "OPTIONAL_OR_DEFAULTED",
              "SYSTEM_PROVIDED"
            ]
          },
          "startup_validation": {
            "type": "string"
          },
          "mechanisms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependency_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "consuming_sources",
          "environments",
          "secret_class",
          "rotation_owner",
          "requiredness",
          "startup_validation",
          "mechanisms",
          "dependency_ids"
        ],
        "additionalProperties": false
      }
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "presence": {
            "type": "string",
            "enum": [
              "PRESENT",
              "ABSENT"
            ]
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "presence",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "dynamic_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "expression": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "RESOLVED_FINITE_CATALOG",
              "RESOLVED_CALLER_POLICY",
              "REQUIRES_BINDING_REVIEW"
            ]
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policy": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "expression",
          "status",
          "names",
          "evidence_sources",
          "policy"
        ],
        "additionalProperties": false
      }
    },
    "source_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "credentialsInUrl": {
            "type": "boolean"
          }
        },
        "required": [
          "hostname",
          "protocol",
          "path",
          "line",
          "credentialsInUrl"
        ],
        "additionalProperties": false
      }
    },
    "fallback_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "scope": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "scope",
          "mechanism",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "owner_command": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "source_paths",
          "summary",
          "disposition",
          "owner_command"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "observed_utc": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "safe_resource": {
            "type": "string"
          },
          "release_sha": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "observed_utc",
          "result",
          "safe_resource",
          "release_sha"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "source_sha",
    "assessment",
    "dependencies",
    "environment_names",
    "manifests",
    "source_hashes",
    "dynamic_bindings",
    "source_endpoints",
    "fallback_candidates",
    "risks",
    "evidence",
    "limitations"
  ],
  "additionalProperties": false
}
