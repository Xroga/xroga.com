{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope": {
      "type": "string",
      "const": "ACCEPTANCE_CONTRACTS_NOT_PRODUCT_COMPLETION"
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "GJ-CHAT",
              "GJ-WEB-RESEARCH",
              "GJ-EXISTING-REPO-CODING",
              "GJ-NEW-SAAS",
              "GJ-BUSINESS-READ",
              "GJ-BUSINESS-WRITE",
              "GJ-MIXED-MULTI-OUTCOME",
              "GJ-DOCUMENTS",
              "GJ-WORK-PACK",
              "GJ-AI-EMPLOYEE",
              "GJ-PAID-ANDROID-PUBLISH",
              "GJ-SEO-DRIVE"
            ]
          },
          "fixtureId": {
            "type": "string",
            "minLength": 1
          },
          "userIntent": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "object",
            "properties": {
              "ownerId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "outsiderId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "realm": {
                "type": "string",
                "const": "ISOLATED_FIXTURE_ONLY"
              }
            },
            "required": [
              "ownerId",
              "outsiderId",
              "realm"
            ],
            "additionalProperties": false
          },
          "requirements": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prerequisiteConnections": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilityClasses": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "planningGraph": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "operation",
                "dependencies"
              ],
              "additionalProperties": false
            }
          },
          "authorityPoints": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "authority": {
                  "type": "string",
                  "minLength": 1
                },
                "boundary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "authority",
                "boundary"
              ],
              "additionalProperties": false
            }
          },
          "budgetRules": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "durableState": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "providerSandboxBehavior": {
            "type": "string",
            "minLength": 1
          },
          "verificationEvidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "kind",
                "requirement"
              ],
              "additionalProperties": false
            }
          },
          "uiEventsBlocks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "completionSemantics": {
            "type": "string",
            "minLength": 1
          },
          "timeoutRetry": {
            "type": "string",
            "minLength": 1
          },
          "cleanup": {
            "type": "string",
            "minLength": 1
          },
          "positiveAssertions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "negativeAssertions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementationPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED_KNOWN_GAP",
              "NOT_APPLICABLE"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "requirementIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "ownerCommands": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "missingCapability": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "requirementIds",
                "ownerCommands",
                "missingCapability"
              ],
              "additionalProperties": false
            }
          },
          "goal": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "fixtureId",
          "userIntent",
          "tenant",
          "requirements",
          "prerequisiteConnections",
          "capabilityClasses",
          "planningGraph",
          "authorityPoints",
          "budgetRules",
          "durableState",
          "providerSandboxBehavior",
          "verificationEvidence",
          "uiEventsBlocks",
          "completionSemantics",
          "timeoutRetry",
          "cleanup",
          "positiveAssertions",
          "negativeAssertions",
          "implementationPaths",
          "state",
          "blockers",
          "goal"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "sourceSha",
    "scope",
    "journeys"
  ],
  "additionalProperties": false
}
