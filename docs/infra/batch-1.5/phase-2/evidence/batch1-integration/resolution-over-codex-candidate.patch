+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { createServer, type IncomingMessage } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { after, afterEach, before, describe, it } from 'node:test';
+import { createTenantContext, type TenantContext } from '../../security/tenantContext.js';
+import { setStorageServiceForTests } from '../../storage/runtime.js';
+import { harness } from '../../storage/testing/harness.js';
+import { StorageError } from '../../storage/types.js';
+
+/**
+ * Phase 1's Drive write modes, re-expressed on Batch 1's `storeProjectFile(context, ...)` (integration verification of the merged tree).
+ * The fake PostgREST enforces what the real policy enforces: a project is visible only to its owner, and an insert receipt must equal the row.
+ */
+describe('storeProjectFile Drive modes on the Batch 1 TenantContext signature', () => {
+  const inserts: Array<Record<string, unknown>> = [];
+  const owners = new Map<string, string>(); // project id -> owner user id
+  let server: ReturnType<typeof createServer>;
+  let store: typeof import('./projectFiles.js');
+  const saved = { ...process.env };
+  const readBody = (req: IncomingMessage) => new Promise<string>((r) => { let b = ''; req.on('data', (c) => (b += c)); req.on('end', () => r(b)); });
+
+  before(async () => {
+    server = createServer(async (req, res) => {
+      const body = await readBody(req);
+      const url = new URL(req.url ?? '/', 'http://x');
+      if (req.method === 'GET' && url.pathname === '/rest/v1/projects') {
+        const id = (url.searchParams.get('id') ?? '').replace(/^eq\./, '');
+        const user = (url.searchParams.get('user_id') ?? '').replace(/^eq\./, '');
+        res.writeHead(200, { 'content-type': 'application/json' });
+        res.end(JSON.stringify(owners.get(id) === user ? [{ id }] : []));
+        return;
+      }
+      if (req.method === 'POST' && url.pathname === '/rest/v1/project_files') {
+        const row = JSON.parse(body) as Record<string, unknown>;
+        inserts.push(row);
+        res.writeHead(201, { 'content-type': 'application/json' });
+        res.end(JSON.stringify(row)); // an exact receipt, as the real policy requires
+        return;
+      }
+      res.writeHead(404).end();
+    });
+    await new Promise<void>((r) => server.listen(0, '127.0.0.1', () => r()));
+    process.env.SUPABASE_URL = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+    process.env.SUPABASE_SERVICE_ROLE_KEY = 'test-service-role';
+    store = await import('./projectFiles.js');
+  });
+  const DRIVE_ENV = { XROGA_DRIVE_R2_ACCOUNT_ID: 'a', XROGA_DRIVE_R2_ACCESS_KEY_ID: 'k', XROGA_DRIVE_R2_SECRET_ACCESS_KEY: 's', XROGA_DRIVE_R2_BUCKET: 'd', DATABASE_URL: 'postgres://x' };
+  const driveEnv = () => Object.assign(process.env, DRIVE_ENV);
+  afterEach(() => { inserts.length = 0; owners.clear(); setStorageServiceForTests(undefined); delete process.env.STORAGE_WRITE_MODE; for (const k of Object.keys(DRIVE_ENV)) delete process.env[k]; });
+  after(() => { server.close(); for (const k of Object.keys(process.env)) if (!(k in saved)) delete process.env[k]; Object.assign(process.env, saved); });
+
+  const ctxFor = (userId: string): TenantContext => createTenantContext({ userId, via: 'persisted_owner' });
+
+  it('legacy mode (default) is Batch 1 behaviour: private delivery, no Drive write, never claims canonical durability', async () => {
+    const h = harness(); setStorageServiceForTests(h.svc); owners.set(h.aliceProject, h.alice.userId);
+    const f = await store.storeProjectFile(ctxFor(h.alice.userId), h.aliceProject, 'a.txt', 'hi', 'text/plain', 'code');
+    assert.notEqual(f.canonicalDurable, true);
+    assert.equal(h.repo.objects.size, 0);
+    assert.equal(inserts[0]!.storage_object_id, undefined);
+    assert.equal((inserts[0]!.storage_metadata as { provider: string }).provider, 'database');
+  });
+
+  it('dual mode writes a verified private Drive object and links it on the record', async () => {
+    process.env.STORAGE_WRITE_MODE = 'dual'; driveEnv();
+    const h = harness(); setStorageServiceForTests(h.svc); owners.set(h.aliceProject, h.alice.userId);
+    const f = await store.storeProjectFile(ctxFor(h.alice.userId), h.aliceProject, 'src_app.ts', 'export const x = 1;', 'text/plain', 'code');
+    assert.equal(f.canonicalDurable, true);
+    assert.equal(inserts[0]!.storage_object_id, f.storageObjectId);
+    assert.equal((await h.repo.getObject(f.storageObjectId!))!.state, 'READY');
+    const mine = await h.svc.listObjects(h.alice, { projectId: h.aliceProject });
+    assert.equal(mine.length, 1);
+    assert.equal((await h.svc.listObjects(h.bob, { projectId: h.bobProject })).length, 0, 'another tenant sees nothing');
+  });
+
+  it('dual mode: a Drive failure never fails the private-delivery write and never claims durability', async () => {
+    process.env.STORAGE_WRITE_MODE = 'dual'; driveEnv();
+    const h = harness(); setStorageServiceForTests(h.svc); owners.set(h.aliceProject, h.alice.userId);
+    h.store.failNext('put', 'throw');
+    const f = await store.storeProjectFile(ctxFor(h.alice.userId), h.aliceProject, 'a.txt', 'hi', 'text/plain', 'code');
+    assert.notEqual(f.canonicalDurable, true);
