@@ -0,0 +1,69 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { decideStartup, dutiesFor, resolveDeploymentEnvironment, PRODUCTION_FLY_APP } from './startupPolicy.js';
+
+const env = (e: Record<string, string | undefined>): NodeJS.ProcessEnv => e;
+const NO_DUTIES = { reconcileOrphanedRuns: false };
+const ALL_DUTIES = { reconcileOrphanedRuns: true };
+
+describe('deployment environment resolution', () => {
+  it('the production Fly app is production with no new configuration, so today\'s deployment is unchanged', () => {
+    const r = resolveDeploymentEnvironment(env({ FLY_APP_NAME: PRODUCTION_FLY_APP, NODE_ENV: 'production' }));
+    assert.deepEqual([r.environment, r.source], ['production', 'inferred']);
+    assert.deepEqual(decideStartup(env({ FLY_APP_NAME: PRODUCTION_FLY_APP })).duties, ALL_DUTIES);
+  });
+
+  it('an explicit environment is honoured', () => {
+    for (const e of ['production', 'staging', 'preview', 'development', 'test']) {
+      assert.equal(resolveDeploymentEnvironment(env({ XROGA_DEPLOYMENT_ENVIRONMENT: e })).environment, e);
+      assert.equal(resolveDeploymentEnvironment(env({ XROGA_DEPLOYMENT_ENVIRONMENT: ` ${e.toUpperCase()} ` })).environment, e, 'case and spaces');
+    }
+  });
+
+  it('an unknown or empty-meaning value is unclassified, not a guess', () => {
+    for (const bad of ['prod', 'live', 'stage', 'yes', 'production;staging']) {
+      const r = resolveDeploymentEnvironment(env({ XROGA_DEPLOYMENT_ENVIRONMENT: bad }));
+      assert.equal(r.environment, 'unclassified', bad);
+      assert.ok(r.problem);
+    }
+  });
+
+  it('a declaration that contradicts the platform is unclassified (staging claim on the production app, production claim on another app)', () => {
+    assert.equal(resolveDeploymentEnvironment(env({ FLY_APP_NAME: PRODUCTION_FLY_APP, XROGA_DEPLOYMENT_ENVIRONMENT: 'staging' })).environment, 'unclassified');
+    assert.equal(resolveDeploymentEnvironment(env({ FLY_APP_NAME: 'xroga-api-staging', XROGA_DEPLOYMENT_ENVIRONMENT: 'production' })).environment, 'unclassified');
+    assert.equal(resolveDeploymentEnvironment(env({ FLY_APP_NAME: 'xroga-api-staging', XROGA_DEPLOYMENT_ENVIRONMENT: 'staging' })).environment, 'staging');
+  });
+
+  it('anything not positively identified is unclassified: another Fly app, Cloud Run, a bare host', () => {
+    for (const e of [{ FLY_APP_NAME: 'xroga-api-staging' }, { FLY_APP_NAME: 'xroga-api-2' }, { K_SERVICE: 'xroga-api' }, { NODE_ENV: 'production' }, {}]) {
+      assert.equal(resolveDeploymentEnvironment(env(e)).environment, 'unclassified', JSON.stringify(e));
+    }
+  });
+
+  it('NODE_ENV alone identifies only local development and test', () => {
+    assert.equal(resolveDeploymentEnvironment(env({ NODE_ENV: 'test' })).environment, 'test');
+    assert.equal(resolveDeploymentEnvironment(env({ NODE_ENV: 'development' })).environment, 'development');
+  });
+});
+
+describe('boot duties', () => {
+  it('only production and local development may write to the database at boot', () => {
+    assert.deepEqual(dutiesFor('production'), ALL_DUTIES);
+    assert.deepEqual(dutiesFor('development'), ALL_DUTIES);
+    for (const e of ['staging', 'preview', 'test', 'unclassified'] as const) assert.deepEqual(dutiesFor(e), NO_DUTIES, e);
+  });
+
+  it('a staging service holding a live service-role key performs no reconcile, and the boot log says so', () => {
+    const d = decideStartup(env({ FLY_APP_NAME: 'xroga-api-staging', XROGA_DEPLOYMENT_ENVIRONMENT: 'staging', SUPABASE_SERVICE_ROLE_KEY: 'x'.repeat(40), SUPABASE_URL: 'https://example.supabase.co' }));
+    assert.deepEqual(d.duties, NO_DUTIES);
+    assert.ok(d.notes.some((n) => /disabled by policy/.test(n)));
+    assert.ok(d.notes.some((n) => /WARNING.*SUPABASE_SERVICE_ROLE_KEY/.test(n)));
+    assert.ok(!JSON.stringify(d).includes('x'.repeat(40)), 'the key itself is never logged');
+  });
+
+  it('a host nobody classified performs no mutating duty even with production credentials present', () => {
+    const d = decideStartup(env({ K_SERVICE: 'cloud-run-staging', SUPABASE_SERVICE_ROLE_KEY: 'k', SUPABASE_URL: 'https://prod.supabase.co' }));
+    assert.deepEqual(d.duties, NO_DUTIES);
+    assert.ok(d.notes.some((n) => /not recognised/.test(n)));
+  });
+});
diff --git a/backend/src/runtime/startupPolicy.ts b/backend/src/runtime/startupPolicy.ts
new file mode 100644
index 00000000..4c4b65f4
--- /dev/null
+++ b/backend/src/runtime/startupPolicy.ts
@@ -0,0 +1,82 @@
+/**
+ * Which deployment this process is, and which boot-time duties it is therefore allowed to perform (INFRA-005).
+ *
+ * At boot the API currently does four things against whatever database its credentials point at: it runs schema-ensure DDL, it fails
+ * every `swarm_runs` row still marked `running` and older than five minutes, it hydrates provider health, and it registers sandbox
+ * providers. A staging, preview or half-configured service that holds a live service-role key therefore rewrites production run state
+ * and schema just by starting. The staging descriptor already sets `XROGA_DEPLOYMENT_ENVIRONMENT=staging` and `RUN_SWARM_WORKER=false`
+ * to say "no production work", but no backend source reads either variable, so nothing enforced it. This module makes the declaration binding.
+ *
+ * The rule is fail closed: only a process positively identified as production (or a local development / test process) may run the
+ * mutating duties. Anything staging, preview, conflicting or unidentifiable runs none of them and says so loudly. The production Fly app is
+ * recognised by name without any new configuration, so today's deployment behaves exactly as before.
+ */
+
+export type DeploymentEnvironment = 'production' | 'staging' | 'preview' | 'development' | 'test' | 'unclassified';
+
+/** The Fly app that serves customers (`fly.api.toml`). A different app name is never production, whatever else it claims. */
+export const PRODUCTION_FLY_APP = 'xroga-api';
+
+const NAMED: readonly DeploymentEnvironment[] = ['production', 'staging', 'preview', 'development', 'test'];
+
+export interface ResolvedEnvironment {
+  environment: DeploymentEnvironment;
+  source: 'explicit' | 'inferred' | 'unknown';
+  /** why the environment is `unclassified`, when it is */
+  problem?: string;
+}
+
+export function resolveDeploymentEnvironment(env: NodeJS.ProcessEnv = process.env): ResolvedEnvironment {
+  const raw = env.XROGA_DEPLOYMENT_ENVIRONMENT?.trim().toLowerCase();
+  const fly = env.FLY_APP_NAME?.trim();
+  if (raw) {
+    if (!(NAMED as readonly string[]).includes(raw)) return { environment: 'unclassified', source: 'unknown', problem: 'XROGA_DEPLOYMENT_ENVIRONMENT is not one of production|staging|preview|development|test' };
+    const claimed = raw as DeploymentEnvironment;
+    // A claim must agree with what the platform says about where this is running.
+    if (fly === PRODUCTION_FLY_APP && claimed !== 'production') return { environment: 'unclassified', source: 'unknown', problem: `running as the production Fly app but declared "${claimed}"` };
+    if (fly && fly !== PRODUCTION_FLY_APP && claimed === 'production') return { environment: 'unclassified', source: 'unknown', problem: `declared production but running as Fly app "${fly.slice(0, 40)}"` };
+    return { environment: claimed, source: 'explicit' };
+  }
+  if (fly === PRODUCTION_FLY_APP) return { environment: 'production', source: 'inferred' };
+  if (env.NODE_ENV === 'test') return { environment: 'test', source: 'inferred' };
+  if (env.NODE_ENV === 'development') return { environment: 'development', source: 'inferred' };
+  return { environment: 'unclassified', source: 'unknown', problem: 'XROGA_DEPLOYMENT_ENVIRONMENT is not set and this is not the production Fly app' };
+}
+
+export interface StartupDuties {
+  /** fail abandoned `running` runs left by a previous process */
+  reconcileOrphanedRuns: boolean;
+}
+
+/** Duties that WRITE to the database at boot. Everything not listed here is read-only or process-local and is not gated. */
+export function dutiesFor(environment: DeploymentEnvironment): StartupDuties {
+  switch (environment) {
+    case 'production':
+    case 'development':
+      return { reconcileOrphanedRuns: true };
+    case 'test':
+    case 'staging':
+    case 'preview':
+    case 'unclassified':
+      return { reconcileOrphanedRuns: false };
+  }
+}
+
+export interface StartupDecision {
+  environment: DeploymentEnvironment;
+  source: ResolvedEnvironment['source'];
+  duties: StartupDuties;
+  /** human-readable lines for the boot log; never contains a secret */
+  notes: string[];
+}
+
+export function decideStartup(env: NodeJS.ProcessEnv = process.env): StartupDecision {
+  const r = resolveDeploymentEnvironment(env);
+  const duties = dutiesFor(r.environment);
+  const notes: string[] = [];
+  if (r.problem) notes.push(`environment not recognised: ${r.problem}; mutating boot duties are disabled`);
+  else if (!duties.reconcileOrphanedRuns) notes.push(`environment "${r.environment}": orphaned-run reconciliation is disabled by policy`);
+  const holdsServiceRole = Boolean(env.SUPABASE_SERVICE_ROLE_KEY);
+  if (holdsServiceRole && (r.environment === 'staging' || r.environment === 'preview')) notes.push(`WARNING: a "${r.environment}" process holds SUPABASE_SERVICE_ROLE_KEY; confirm it points at a disposable project`);
+  return { environment: r.environment, source: r.source, duties, notes };
+}
