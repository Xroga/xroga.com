{
  "name": "xroga",
  "version": "0.1.0",
  "private": true,
  "description": "Xroga – AI Swarm Operating System",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=backend && npm run test:frontend",
    "test:frontend": "tsx --test \"frontend/src/**/*.test.ts\"",
    "test:resilience": "node scripts/test-resilience.js",
    "test:seo": "node scripts/seo-audit.mjs",
    "seo:indexnow": "tsx scripts/growth-publishing/cli.ts indexnow",
    "growth:intelligence": "tsx backend/src/organicIntelligence/cli.ts intelligence",
    "growth:entities": "tsx backend/src/organicIntelligence/cli.ts entities",
    "growth:gaps": "tsx backend/src/organicIntelligence/cli.ts gaps",
    "growth:discover": "tsx backend/src/organicIntelligence/cli.ts discover",
    "growth:report": "tsx backend/src/organicIntelligence/cli.ts report",
    "growth:validate": "tsx backend/src/organicIntelligence/cli.ts validate",
    "growth:research": "tsx backend/src/organicIntelligence/content/cli.ts research",
    "growth:brief": "tsx backend/src/organicIntelligence/content/cli.ts brief",
    "growth:content": "tsx backend/src/organicIntelligence/content/cli.ts content",
    "growth:content:validate": "tsx backend/src/organicIntelligence/content/cli.ts validate",
    "growth:links": "tsx backend/src/organicIntelligence/content/cli.ts links",
    "growth:visuals": "tsx backend/src/organicIntelligence/content/cli.ts visuals",
    "growth:changed-urls": "tsx scripts/growth-publishing/cli.ts changed-urls",
    "growth:ship": "tsx scripts/growth-publishing/cli.ts ship",
    "growth:verify-live": "tsx scripts/growth-publishing/cli.ts verify-live",
    "growth:refresh": "tsx scripts/growth-publishing/cli.ts refresh",
    "growth:sync": "tsx scripts/growth-publishing/cli.ts sync",
    "growth:drift": "tsx scripts/growth-publishing/cli.ts drift",
    "growth:feeds": "tsx scripts/growth-publishing/cli.ts feeds",
    "growth:crawl": "tsx scripts/growth-publishing/cli.ts crawl",
    "growth:crawlers": "tsx scripts/growth-publishing/cli.ts crawlers",
    "growth:technical:validate": "tsx scripts/growth-publishing/cli.ts validate",
    "growth:status": "tsx scripts/growth-publishing/cli.ts status --json",
    "test:growth": "tsx --test \"backend/src/organicIntelligence/**/*.test.ts\"",
    "test:growth:technical": "tsx --test \"scripts/growth-publishing/**/*.test.ts\"",
    "growth:authority": "tsx backend/src/organicIntelligence/authority/cli.ts authority",
    "growth:mentions": "tsx backend/src/organicIntelligence/authority/cli.ts mentions",
    "growth:distribute": "tsx backend/src/organicIntelligence/authority/cli.ts distribute",
    "growth:github": "tsx backend/src/organicIntelligence/authority/cli.ts github",
    "growth:oss": "tsx backend/src/organicIntelligence/authority/cli.ts oss",
    "growth:video": "tsx backend/src/organicIntelligence/authority/cli.ts video",
    "growth:creators": "tsx backend/src/organicIntelligence/authority/cli.ts creators",
    "growth:reports": "tsx backend/src/organicIntelligence/authority/cli.ts reports",
    "growth:badge": "tsx backend/src/organicIntelligence/authority/cli.ts badge",
    "growth:authority:validate": "tsx backend/src/organicIntelligence/authority/cli.ts validate",
    "project:check": "node tools/xroga-project-check/cli.mjs",
    "test:project-check": "node --test \"tools/xroga-project-check/*.test.mjs\"",
    "test:growth:authority": "tsx --test \"backend/src/organicIntelligence/authority/**/*.test.ts\""
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "concurrently": "10.0.4",
    "pg": "^8.14.1",
    "zod": "4.6.5"
  }
}
